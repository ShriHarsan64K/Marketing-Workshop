# Copy to .env for local use (never commit .env)
ADMIN_PASSWORD=pick-a-long-password
# SECRET_KEY is optional: one is generated and kept in instance/secret_key
# SECRET_KEY=
# Only for http://localhost (production uses https and secure cookies):
INSECURE_COOKIES=1
# DATA_DIR=/path/to/persistent/folder   # database + uploads live here (default: ./instance)
